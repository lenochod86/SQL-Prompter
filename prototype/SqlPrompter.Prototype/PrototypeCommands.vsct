      <Button guid="guidPrototypeCmdSet" id="cmdidTestConnection" priority="0x0101" type="Button">
        <Parent guid="guidPrototypeCmdSet" id="PrototypeMenuGroup" />
        <Strings>
          <ButtonText>Test Own Connection (Read-Only)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidPrototypeCmdSet" id="cmdidOpenLog" priority="0x0102" type="Button">
        <Parent guid="guidPrototypeCmdSet" id="PrototypeMenuGroup" />
        <Strings>
          <ButtonText>Open Prototype Log</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidPrototypeCmdSet" id="cmdidToggleHello" priority="0x0103" type="Button">
        <Parent guid="guidPrototypeCmdSet" id="PrototypeMenuGroup" />
        <Strings>
          <ButtonText>Hello Suggestions Enabled</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

