  <Commands package="guidPrototypePackage">
    <Menus>
      <Menu guid="guidPrototypeCmdSet" id="PrototypeMenu" priority="0x0100" type="Menu">
        <Parent guid="guidPrototypeCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>SQL Prompter (prototype)</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidPrototypeCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidPrototypeCmdSet" id="PrototypeMenuGroup" priority="0x0100">
        <Parent guid="guidPrototypeCmdSet" id="PrototypeMenu" />
      </Group>
    </Groups>

    <Buttons>
