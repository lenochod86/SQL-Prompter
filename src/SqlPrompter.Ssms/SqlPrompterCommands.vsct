          <ButtonText>Remove Unused Variables</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidOpenLog" priority="0x0100" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="DiagnosticsGroup" />
        <Strings>
          <ButtonText>Open Log</ButtonText>
