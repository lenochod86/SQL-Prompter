  <Commands package="guidSqlPrompterPackage">
    <Menus>
      <!-- Own menu next to Tools, Extensions and Window (SSMS moves it under Extensions by default). New commands go into its groups. -->
      <Menu guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>SQL Prompter</ButtonText>
          <CommandName>SQL Prompter</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidSqlPrompterCmdSet" id="RefactorMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlPrompterCmdSet" id="RefactorHostGroup" />
        <Strings>
          <ButtonText>Refactor</ButtonText>
          <CommandName>Refactor</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- A group on the Standard toolbar (it holds New Query); the query history button sits in it. -->
      <Group guid="guidSqlPrompterCmdSet" id="ToolbarGroup" priority="0x0900">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_TOOL_STANDARD" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="MetadataGroup" priority="0x0100">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="SettingsGroup" priority="0x0200">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="SnippetsGroup" priority="0x0300">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="NavigationGroup" priority="0x0400">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="EditingGroup" priority="0x0500">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="FormattingGroup" priority="0x0540">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="RefactorHostGroup" priority="0x0560">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="RefactoringGroup" priority="0x0100">
        <Parent guid="guidSqlPrompterCmdSet" id="RefactorMenu" />
      </Group>
      <Group guid="guidSqlPrompterCmdSet" id="DiagnosticsGroup" priority="0x0F00">
        <Parent guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidRefreshMetadata" priority="0x0100" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="MetadataGroup" />
        <Strings>
          <ButtonText>Refresh Metadata</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidSettings" priority="0x0099" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="SettingsGroup" />
        <Strings>
          <ButtonText>Settings...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidFormattingStyles" priority="0x009A" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="SettingsGroup" />
        <Strings>
          <ButtonText>Formatting Styles...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidSurroundWithSnippet" priority="0x0090" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="SnippetsGroup" />
        <Strings>
          <ButtonText>Surround Selection With Snippet...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidNewSnippetFromSelection" priority="0x0091" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="SnippetsGroup" />
        <Strings>
          <ButtonText>New Snippet From Selection...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidManageSnippets" priority="0x0092" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="SnippetsGroup" />
        <Strings>
          <ButtonText>Manage Snippets...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidPickerLeft" priority="0x00F1" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="NavigationGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Picker Left</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidPickerRight" priority="0x00F2" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="NavigationGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Picker Right</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidShowSuggestions" priority="0x00F0" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="NavigationGroup" />
        <Strings>
          <ButtonText>Show Suggestions</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidGoToDefinition" priority="0x0100" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="NavigationGroup" />
        <Strings>
          <ButtonText>Go To Definition</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidRunStatement" priority="0x0101" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="NavigationGroup" />
        <Strings>
          <ButtonText>Run Statement At Caret</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidQueryHistory" priority="0x0103" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="NavigationGroup" />
        <Icon guid="ImageCatalogGuid" id="History" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Query History...</ButtonText>
          <ToolTipText>Open the query history</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidParameterInfo" priority="0x0102" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="NavigationGroup" />
        <Strings>
          <ButtonText>Parameter Info</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidAddCommas" priority="0x0220" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="RefactoringGroup" />
        <Strings>
