  <Commands package="guidSqlPrompterPackage">
    <Menus>
      <!-- Own menu next to Tools, Extensions and Window (SSMS moves it under Extensions by default). New commands go into its groups. -->
      <Menu guid="guidSqlPrompterCmdSet" id="SqlPrompterMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>SQL Prompter</ButtonText>
          <CommandName>SQL Prompter</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidSqlPrompterCmdSet" id="MetadataGroup" priority="0x0100">
