      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidQualifyNames" priority="0x00E0" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="RefactoringGroup" />
        <Strings>
          <ButtonText>Qualify Object Names</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlPrompterCmdSet" id="cmdidExpandStars" priority="0x00F0" type="Button">
        <Parent guid="guidSqlPrompterCmdSet" id="RefactoringGroup" />
        <Strings>
          <ButtonText>Expand All Select Stars</ButtonText>
